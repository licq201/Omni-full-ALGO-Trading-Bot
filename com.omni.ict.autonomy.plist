<?xml version="1.0" encoding="UTF-8"?>
<!--
  com.omni.ict.autonomy.plist — macOS LaunchAgent for OMNI-ICT.

  Install (per-user, runs while you are logged in):
      1. cp com.omni.ict.autonomy.plist ~/Library/LaunchAgents/
      2. launchctl load  ~/Library/LaunchAgents/com.omni.ict.autonomy.plist
      3. launchctl start com.omni.ict.autonomy

  Stop:    launchctl stop   com.omni.ict.autonomy
  Restart: launchctl kickstart -k gui/$(id -u)/com.omni.ict.autonomy
  Remove:  launchctl unload ~/Library/LaunchAgents/com.omni.ict.autonomy.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.omni.ict.autonomy</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/python3</string>
    <string>/Users/yuhfriendchris/Omni-full-ALGO-Trading-Bot/python/watchdog.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/yuhfriendchris/Omni-full-ALGO-Trading-Bot</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
    <key>Crashed</key>
    <true/>
  </dict>

  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>Nice</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>/Users/yuhfriendchris/Omni-full-ALGO-Trading-Bot/logs/launchagent.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/yuhfriendchris/Omni-full-ALGO-Trading-Bot/logs/launchagent.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
    <key>OMNI_PAPER_MODE</key>
    <string>true</string>
    <key>OMNI_LICENSE_MODE</key>
    <string>local</string>
  </dict>
</dict>
</plist>
