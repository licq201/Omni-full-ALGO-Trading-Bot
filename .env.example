# ═══════════════════════════════════════════════════════════════
#  OMNI-ICT Auto Trader — Environment Configuration
#  Copy this file to .env and fill in your values.
#  NEVER share your .env file with anyone.
# ═══════════════════════════════════════════════════════════════

# ── Authorization Mode ───────────────────────────────────────
# local = offline/local authorization; no external license server is contacted.
# remote = SaaS subscription validation; requires OMNI_LICENSE_KEY.
OMNI_LICENSE_MODE=local
# OMNI_LICENSE_KEY=OMNI-XXXX-XXXX-XXXX
# OMNI_LICENSE_SERVER=https://omni-full-algo-trading-bot-production.up.railway.app

# ── Telegram Bot ─────────────────────────────────────────────
# Create your bot at https://t.me/BotFather → /newbot
# Copy the token it gives you here.
OMNI_TELEGRAM_TOKEN=your_telegram_bot_token_here

# ── MT5 Credentials ──────────────────────────────────────────
# Open your MT5 account at: https://www.midasfx.com/?ib=1128101
# Then paste your login details below.
MT5_LOGIN=your_mt5_account_number
MT5_PASSWORD=your_mt5_password
MT5_SERVER=your_broker_server_name

# ── Risk Mode ────────────────────────────────────────────────
# LOW = 0.5% risk | MODERATE = 1% risk | HIGH = 2% risk
OMNI_RISK_MODE=MODERATE

# ── Frequency Mode ───────────────────────────────────────────
# CONSERVATIVE = A+ setups only | NORMAL = balanced | AGGRESSIVE = all setups
OMNI_FREQ_MODE=NORMAL

# ── Paper Mode (KEEP TRUE until you're ready for live trading) ──
# true = simulate trades only (no real money)
# false = LIVE TRADING (real money at risk)
OMNI_PAPER_MODE=true

# ── Anthropic API Key (for AI market analysis) ───────────────
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional Overrides ───────────────────────────────────────
# Uncomment and adjust if you want to fine-tune beyond the modes above.
# OMNI_BASE_RISK=1.0
# OMNI_MAX_RISK=2.0
# OMNI_DAILY_LOSS=3.0
# OMNI_MAX_DD=10.0
# OMNI_MIN_CONF=65
# OMNI_MAX_TRADES=3
# OMNI_SCAN_INTERVAL=10
